# Copy to `.env` and fill in ONLY when you have official API access.
# NEVER commit .env or real keys to version control.

# --- Official YouTube Data API (optional) -----------------------------------
# Requires a Google Cloud project with the YouTube Data API v3 enabled and an
# API key. Used only for metadata enrichment where permitted. Leave empty to
# use public metadata extraction only.
YOUTUBE_API_KEY=

# --- TikTok (optional) ------------------------------------------------------
# TikTok does not provide an official download API for third-party apps.
# Leave empty. Only official platform features are used.
TIKTOK_API_KEY=

# --- Facebook (optional) ----------------------------------------------------
# Facebook download access requires official Graph API permissions granted by
# Facebook. Only content your app is authorized to access can be retrieved.
FACEBOOK_API_KEY=

# --- Network defaults (overridable in the Settings page) --------------------
NETWORK_TIMEOUT=30
NETWORK_RETRIES=3
CONCURRENT_DOWNLOADS=3
